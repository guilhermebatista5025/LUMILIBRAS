{
  "name": "lumilibras",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup:camera": "node scripts/setup-camera.mjs",
    "predev": "npm run setup:camera",
    "prebuild": "npm run setup:camera",
    "dev": "concurrently -k -n API,WEB -c yellow,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "nodemon server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "test:aprendizado": "node --test scripts/aprendizado.test.js",
    "test:game": "node --test scripts/game.test.js",
    "start": "node server/index.js",
    "check": "npm run check:brand && npm run build",
    "check:brand": "node scripts/check-brand.js"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.0.1",
    "@supabase/supabase-js": "^2.116.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "lucide-react": "^1.44.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "nodemon": "^3.1.14",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.2"
  }
}
