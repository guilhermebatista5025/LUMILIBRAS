# Copie para .env e preencha as credenciais somente na cópia local.
# O .env é ignorado pelo Git; este modelo deve ficar sem credenciais reais.
NODE_ENV=development
PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# URL e chave publishable do projeto Supabase.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Alternativa legada, somente se não usar publishable:
# SUPABASE_ANON_KEY=

# Opcional, para proxy confiável nesta máquina:
# TRUST_PROXY=loopback
